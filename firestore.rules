rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "fathy93091@gmail.com"
      );
    }

    function isOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId || isAdmin()
      );
    }

    // Connection probe test document
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Primary User Workspace: Each authenticated teacher has access to their isolated root doc and subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{allChildren=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Students collection
    match /students/{studentId} {
      allow read, write: if isSignedIn();
    }

    // Sessions collection
    match /sessions/{sessionId} {
      allow read, write: if isSignedIn();
    }

    // Daily Reports collection
    match /dailyReports/{reportId} {
      allow read, write: if isSignedIn();
    }

    // Monthly Reports collection
    match /monthlyReports/{monthlyReportId} {
      allow read, write: if isSignedIn();
    }

    // Student Memories collection
    match /studentMemories/{studentMemoryId} {
      allow read, write: if isSignedIn();
    }

    // Settings collection
    match /settings/{settingsId} {
      allow read, write: if isSignedIn();
    }
  }
}


